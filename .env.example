# ==========================================
# APPLICATION CONFIGURATION
# ==========================================

SPRING_APPLICATION_NAME=E-commerce
SERVER_PORT=8080

# Frontend configuration
APP_CORS_ALLOWED_ORIGIN=http://localhost:2000
FRONTEND_URL=http://localhost:2000
APP_FRONTEND_URL=http://localhost:2000


# ==========================================
# ZOHO CATALYST CONFIGURATION
# ==========================================

APP_CATALYST_ENABLED=true

ZOHO_CATALYST_PROJECT_ID=your_catalyst_project_id
ZOHO_CATALYST_PROJECT_KEY=your_catalyst_project_key
ZOHO_CATALYST_PROJECT_DOMAIN=https://api.catalyst.zoho.in
ZOHO_CATALYST_ENVIRONMENT=Development

ZOHO_CATALYST_CLIENT_ID=your_catalyst_client_id
ZOHO_CATALYST_CLIENT_SECRET=your_catalyst_client_secret
ZOHO_CATALYST_REFRESH_TOKEN=your_catalyst_refresh_token


# ==========================================
# ZOHO OAUTH CONFIGURATION
# ==========================================

# Zoho Accounts Data Center
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in

ZOHO_CLIENT_ID=your_zoho_oauth_client_id
ZOHO_CLIENT_SECRET=your_zoho_oauth_client_secret

# Must match the redirect URI configured in Zoho API Console
ZOHO_REDIRECT_URI=http://localhost:8080/auth/zoho/callback


# ==========================================
# STRIPE CONFIGURATION
# ==========================================

STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret


# ==========================================
# OPTIONAL GOOGLE OAUTH CONFIGURATION
# ==========================================

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
```
