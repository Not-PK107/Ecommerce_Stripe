STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here


spring.application.name=E-commerce
server.port=8080
app.catalyst.enabled=true
app.cors.allowed-origin=${APP_CORS_ALLOWED_ORIGIN:http://localhost:2000}
app.frontend-url=${FRONTEND_URL:${APP_FRONTEND_URL:http://localhost:2000}}

# Catalyst project configuration
zoho.catalyst.project-id=${ZOHO_CATALYST_PROJECT_ID:demo-project-id}
zoho.catalyst.project-key=${ZOHO_CATALYST_PROJECT_KEY:demo-project-key}
zoho.catalyst.project-domain=${ZOHO_CATALYST_PROJECT_DOMAIN:https://api.catalyst.zoho.in}
zoho.catalyst.environment=${ZOHO_CATALYST_ENVIRONMENT:Development}
zoho.oauth.scopes=openid,email,profile

# Configurable Zoho Accounts Data Center domain (e.g. https://accounts.zoho.in, https://accounts.zoho.com, https://accounts.zoho.eu)
zoho.accounts.base-url=${ZOHO_ACCOUNTS_URL:https://accounts.zoho.in}

# OAuth credentials
zoho.client-id=${ZOHO_CLIENT_ID:demo-zoho-client-id}
zoho.client-secret=${ZOHO_CLIENT_SECRET:demo-zoho-client-secret}
zoho.redirect-uri=${ZOHO_REDIRECT_URI:http://localhost:8080/auth/zoho/callback}

# Spring Security OAuth2 Client for Zoho Accounts
spring.security.oauth2.client.registration.zoho.client-id=${ZOHO_CLIENT_ID:demo-zoho-client-id}
spring.security.oauth2.client.registration.zoho.client-secret=${ZOHO_CLIENT_SECRET:demo-zoho-client-secret}
spring.security.oauth2.client.registration.zoho.client-name=Zoho
spring.security.oauth2.client.registration.zoho.provider=zoho
spring.security.oauth2.client.registration.zoho.authorization-grant-type=authorization_code
spring.security.oauth2.client.registration.zoho.redirect-uri=${ZOHO_REDIRECT_URI:http://localhost:8080/auth/zoho/callback}
spring.security.oauth2.client.registration.zoho.scope=openid,email,profile
spring.security.oauth2.client.registration.zoho.client-authentication-method=client_secret_post

spring.security.oauth2.client.provider.zoho.authorization-uri=${zoho.accounts.base-url}/oauth/v2/auth
spring.security.oauth2.client.provider.zoho.token-uri=${zoho.accounts.base-url}/oauth/v2/token
spring.security.oauth2.client.provider.zoho.user-info-uri=${zoho.accounts.base-url}/oauth/v2/userinfo
spring.security.oauth2.client.provider.zoho.jwk-set-uri=${zoho.accounts.base-url}/oauth/v2/keys
spring.security.oauth2.client.provider.zoho.user-name-attribute=email

# Session & Cookie configuration
server.servlet.session.cookie.http-only=true
server.servlet.session.cookie.same-site=lax
zoho.catalyst.client-id=${ZOHO_CATALYST_CLIENT_ID:demo-client-id}
zoho.catalyst.client-secret=${ZOHO_CATALYST_CLIENT_SECRET:demo-client-secret}
zoho.catalyst.refresh-token=${ZOHO_CATALYST_REFRESH_TOKEN:demo-refresh-token}

# Stripe configurations
stripe.secret-key=${STRIPE_SECRET_KEY:sk_test_dummy}
stripe.publishable-key=${STRIPE_PUBLISHABLE_KEY:pk_test_dummy}
stripe.webhook-secret=${STRIPE_WEBHOOK_SECRET:whsec_test_dummy}

## Optional credentials if google sign-in to be implemented
#Google-client-secret = ${Google-client-secret}
#Google-client-id = ${Google-client-id}


